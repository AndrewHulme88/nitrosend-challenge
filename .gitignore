.DS_Store

# Rails: logs, tempfiles and uploads
backend/log/*
!backend/log/.keep
backend/tmp/*
!backend/tmp/.keep
backend/tmp/pids/*
!backend/tmp/pids/
!backend/tmp/pids/.keep

# Secrets. credentials.yml.enc is encrypted and safe to commit; the key is not.
backend/config/master.key
backend/config/credentials/*.key
**/.env
**/.env.*
!**/.env.example

# Vite builds the frontend into the Rails public directory.
backend/public/*
!backend/public/robots.txt

# Node
node_modules/
*.log
npm-debug.log*
.vite/
