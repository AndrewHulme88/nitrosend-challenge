/.git/
/.gitignore
/.github

# Build and deploy configuration
/.dockerignore
/Dockerfile*
/docker-compose.yml
/fly.toml

# Bundler config and environment files
/backend/.bundle
**/.env*

# Key files. RAILS_MASTER_KEY is supplied at runtime instead.
/backend/config/master.key
/backend/config/credentials/*.key

# Logs, tempfiles and storage, keeping the directories.
/backend/log/*
!/backend/log/.keep
/backend/tmp/*
!/backend/tmp/.keep
/backend/tmp/pids/*
!/backend/tmp/pids/.keep

# Local frontend build output. The image builds it from source instead, so
# copying it in would risk shipping a stale bundle.
/backend/public/assets
/backend/public/index.html

/frontend/node_modules
/frontend/dist
